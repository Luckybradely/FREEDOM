<section class="section">
  <div class="container">
    {% for block in section.blocks %}
      <div class="app-block">{% render block %}</div>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Applications",
  "blocks": [{ "type": "@app" }],
  "presets": [{ "name": "Applications" }]
}
{% endschema %}
