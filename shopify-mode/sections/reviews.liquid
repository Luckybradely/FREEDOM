<section class="section reviews">
  <div class="container container--narrow">
    <h2 class="section__title">{{ section.settings.heading }}</h2>
    {% for block in section.blocks %}
      {% render block %}
    {% else %}
      <p class="center muted">Installez une application d'avis (Judge.me, Loox…), puis ajoutez son bloc à cette section dans l'éditeur de thème.</p>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Avis clients",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titre", "default": "AVIS" }
  ],
  "blocks": [{ "type": "@app" }],
  "presets": [{ "name": "Avis clients" }]
}
{% endschema %}
