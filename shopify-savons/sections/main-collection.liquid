<section class="section">
  <div class="container">
    <h1>{{ collection.title }}</h1>
    {% if collection.description != blank %}<div class="rte">{{ collection.description }}</div>{% endif %}

    {% paginate collection.products by section.settings.products_per_page %}
      <div class="grid grid--4">
        {% for product in collection.products %}
          {% render 'product-card', product: product %}
        {% else %}
          <p>Aucun produit dans cette collection pour le moment.</p>
        {% endfor %}
      </div>
      {% if paginate.pages > 1 %}
        <div class="pagination">{{ paginate | default_pagination }}</div>
      {% endif %}
    {% endpaginate %}
  </div>
</section>

{% schema %}
{
  "name": "Collection",
  "settings": [
    { "type": "range", "id": "products_per_page", "label": "Produits par page", "min": 4, "max": 24, "step": 4, "default": 12 }
  ]
}
{% endschema %}
