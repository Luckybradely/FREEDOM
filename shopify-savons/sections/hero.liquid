<section class="hero">
  <div class="container hero__inner">
    <div class="hero__content">
      <h1>{{ section.settings.heading }}</h1>
      <p class="hero__text">{{ section.settings.text }}</p>
      {% if section.settings.button_label != blank %}
        <a class="button" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label }}</a>
      {% endif %}
    </div>
    <div class="hero__media">
      {% if section.settings.image != blank %}
        {{ section.settings.image | image_url: width: 1000 | image_tag: loading: 'eager', alt: section.settings.heading }}
      {% else %}
        <div class="hero__placeholder" aria-hidden="true"></div>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Bannière d'accueil",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titre", "default": "Une peau propre. Une odeur neutre." },
    { "type": "textarea", "id": "text", "label": "Texte", "default": "Des savons doux pour la peau mature." },
    { "type": "text", "id": "button_label", "label": "Texte du bouton", "default": "Voir nos savons" },
    { "type": "url", "id": "button_link", "label": "Lien du bouton" },
    { "type": "image_picker", "id": "image", "label": "Image" }
  ],
  "presets": [{ "name": "Bannière d'accueil" }]
}
{% endschema %}
