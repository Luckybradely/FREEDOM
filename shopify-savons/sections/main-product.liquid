{%- assign current = product.selected_or_first_available_variant -%}
<section class="section section--product">
  <div class="container product">
    <div class="product__media" data-gallery>
      <div class="product__main">
        {% if product.featured_media %}
          {{ product.featured_media | image_url: width: 1000 | image_tag: loading: 'eager', alt: product.title, data-gallery-main: '' }}
        {% else %}
          <div class="card__placeholder" aria-hidden="true"></div>
        {% endif %}
        {% if product.media.size > 1 %}
          <button type="button" class="gallery-arrow gallery-arrow--prev" data-step="-1" aria-label="Image précédente">‹</button>
          <button type="button" class="gallery-arrow gallery-arrow--next" data-step="1" aria-label="Image suivante">›</button>
        {% endif %}
      </div>
      {% if product.media.size > 1 %}
        <div class="product__thumbs">
          {% for media in product.media %}
            {%- assign alt_text = media.alt | default: product.title -%}
            <button type="button" class="product__thumb{% if forloop.first %} is-active{% endif %}" data-src="{{ media.preview_image | image_url: width: 1000 }}" aria-label="Image {{ forloop.index }}">
              {{ media.preview_image | image_url: width: 160 | image_tag: loading: 'lazy', alt: alt_text }}
            </button>
          {% endfor %}
        </div>
      {% endif %}
      {% if section.settings.quote != blank %}
        <blockquote class="product__quote">
          <div class="product__quote-head">
            {% render 'stars', count: 5 %} <strong>{{ section.settings.quote_author }}</strong>
            <span class="product__verified">{% render 'icon', name: 'check' %} Acheteur vérifié</span>
          </div>
          <p>« {{ section.settings.quote }} »</p>
        </blockquote>
      {% endif %}
    </div>

    <div class="product__info">
      {% if section.settings.rating_text != blank %}
        <p class="product__rating">{% render 'stars', count: 5 %} <strong>{{ section.settings.rating_text }}</strong></p>
      {% endif %}
      <h1>{{ product.title }}</h1>
      <div class="product__description rte">{{ product.description }}</div>

      {% form 'product', product %}
        {% unless product.has_only_default_variant %}
          <p class="divider"><span>{{ section.settings.bundle_title }}</span></p>
          <div class="bundles">
            {% for variant in product.variants %}
              {%- assign units = variant.metafields.custom.units.value | plus: 0 -%}
              {%- assign bonus = variant.metafields.custom.bonus.value -%}
              <label class="bundle">
                <input type="radio" name="id" value="{{ variant.id }}"{% if variant == current %} checked{% endif %}{% unless variant.available %} disabled{% endunless %}>
                <span class="bundle__box">
                  {% if forloop.index == section.settings.popular_index %}<span class="bundle__badge">{{ section.settings.popular_label }}</span>{% endif %}
                  <span class="bundle__row">
                    <span class="bundle__radio" aria-hidden="true"></span>
                    <span class="bundle__name">
                      {{ variant.title }}
                      {% if units > 0 %}<small>{{ variant.price | divided_by: units | money }} / unité</small>{% endif %}
                    </span>
                    <span class="bundle__price">
                      {{ variant.price | money }}
                      {% if variant.compare_at_price > variant.price %}<s>{{ variant.compare_at_price | money }}</s>{% endif %}
                    </span>
                  </span>
                  {% if bonus != blank %}<span class="bundle__bonus">{% render 'icon', name: 'gift' %} {{ bonus }}</span>{% endif %}
                </span>
              </label>
            {% endfor %}
          </div>
        {% else %}
          <input type="hidden" name="id" value="{{ current.id }}">
          <p class="product__price">
            {{ current.price | money }}
            {% if current.compare_at_price > current.price %}<s>{{ current.compare_at_price | money }}</s>{% endif %}
          </p>
        {% endunless %}

        {%- comment -%} Abonnement : s'affiche si le produit a un plan d'abonnement (appli Shopify Subscriptions). {%- endcomment -%}
        {%- assign plan = product.selling_plan_groups.first.selling_plans.first -%}
        {% if plan %}
          <label class="subscribe">
            <input type="checkbox" name="selling_plan" value="{{ plan.id }}"{% if product.requires_selling_plan %} checked disabled{% endif %}>
            <span class="subscribe__box" aria-hidden="true">{% render 'icon', name: 'check' %}</span>
            <span>
              <strong>{{ section.settings.subscribe_title | default: plan.name }}</strong>
              {% if section.settings.subscribe_text != blank %}<small>{{ section.settings.subscribe_text }}</small>{% endif %}
            </span>
          </label>
        {% endif %}

        {% if section.settings.shipping_note != blank %}
          <p class="product__note">{% render 'icon', name: 'leaf' %} {{ section.settings.shipping_note }}</p>
        {% endif %}

        <button class="button button--full button--big" type="submit"{% unless current.available %} disabled{% endunless %}>
          {% if current.available %}Ajouter au panier{% else %}Épuisé{% endif %}
        </button>
      {% endform %}

      {% if section.settings.under_button != blank %}<p class="product__under">{{ section.settings.under_button }}</p>{% endif %}
      <div class="payment-icons">{{ shop.enabled_payment_types | payment_type_svg_tag: class: 'payment-icon' }}</div>

      <div class="trust">
        {% for i in (1..3) %}
          {%- assign t_key = 'trust_' | append: i -%}
          {%- assign icon_key = 'trust_icon_' | append: i -%}
          {% if section.settings[t_key] != blank %}
            <div class="trust__item">
              <span class="trust__icon">{% render 'icon', name: section.settings[icon_key] %}</span>
              <p>{{ section.settings[t_key] }}</p>
            </div>
          {% endif %}
        {% endfor %}
      </div>

      {% for block in section.blocks %}
        {% case block.type %}
          {% when 'question' %}
            <details class="faq" {{ block.shopify_attributes }}>
              <summary>{{ block.settings.question }}<span class="faq__plus">{% render 'icon', name: 'plus' %}</span></summary>
              <p>{{ block.settings.answer }}</p>
            </details>
          {% when '@app' %}
            <div class="app-block">{% render block %}</div>
        {% endcase %}
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Fiche produit",
  "settings": [
    { "type": "paragraph", "content": "Métachamps de variante facultatifs : custom.units (nombre de savons, pour le prix par unité) et custom.bonus (texte du cadeau, ex. « + porte-savon offert »)." },
    { "type": "text", "id": "rating_text", "label": "Ligne à côté des étoiles", "info": "N'affichez que des chiffres vrais." },
    { "type": "text", "id": "bundle_title", "label": "Titre des lots", "default": "PLUS VOUS EN PRENEZ, PLUS VOUS ÉCONOMISEZ" },
    { "type": "range", "id": "popular_index", "label": "Lot « le plus populaire » (position, 0 = aucun)", "min": 0, "max": 6, "step": 1, "default": 0 },
    { "type": "text", "id": "popular_label", "label": "Libellé du badge", "default": "LE PLUS POPULAIRE" },
    { "type": "text", "id": "subscribe_title", "label": "Titre de l'abonnement", "default": "Abonnez-vous et économisez" },
    { "type": "text", "id": "subscribe_text", "label": "Texte de l'abonnement", "default": "Sans engagement, annulable à tout moment." },
    { "type": "text", "id": "shipping_note", "label": "Message au-dessus du bouton", "default": "Plus vous commandez, moins l'expédition vous coûte par savon." },
    { "type": "text", "id": "under_button", "label": "Message sous le bouton" },
    { "type": "textarea", "id": "quote", "label": "Témoignage sous les photos (un vrai client)" },
    { "type": "text", "id": "quote_author", "label": "Auteur du témoignage" },
    { "type": "header", "content": "Pastilles de confiance" },
    { "type": "select", "id": "trust_icon_1", "label": "Icône 1", "default": "clock", "options": [{ "value": "clock", "label": "Horloge" }, { "value": "shield", "label": "Bouclier" }, { "value": "drop", "label": "Goutte" }, { "value": "leaf", "label": "Feuille" }, { "value": "heart", "label": "Cœur" }] },
    { "type": "text", "id": "trust_1", "label": "Texte 1", "default": "Efficace dès la première douche" },
    { "type": "select", "id": "trust_icon_2", "label": "Icône 2", "default": "shield", "options": [{ "value": "clock", "label": "Horloge" }, { "value": "shield", "label": "Bouclier" }, { "value": "drop", "label": "Goutte" }, { "value": "leaf", "label": "Feuille" }, { "value": "heart", "label": "Cœur" }] },
    { "type": "text", "id": "trust_2", "label": "Texte 2", "default": "Satisfait ou remboursé" },
    { "type": "select", "id": "trust_icon_3", "label": "Icône 3", "default": "drop", "options": [{ "value": "clock", "label": "Horloge" }, { "value": "shield", "label": "Bouclier" }, { "value": "drop", "label": "Goutte" }, { "value": "leaf", "label": "Feuille" }, { "value": "heart", "label": "Cœur" }] },
    { "type": "text", "id": "trust_3", "label": "Texte 3", "default": "Doux pour la peau mature" }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "Question" },
        { "type": "textarea", "id": "answer", "label": "Réponse" }
      ]
    },
    { "type": "@app" }
  ]
}
{% endschema %}
