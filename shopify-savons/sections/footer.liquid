<footer class="footer">
  <div class="container">
    <div class="footer__news">
      <div>
        <h2>{{ section.settings.heading }} <em>{{ section.settings.heading_accent }}</em></h2>
        <p>{{ section.settings.text }}</p>
      </div>
      {% form 'customer', class: 'newsletter' %}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <label class="visually-hidden" for="nl-email">Votre adresse e-mail</label>
        <input id="nl-email" type="email" name="contact[email]" placeholder="Votre adresse e-mail" required autocomplete="email">
        <button class="button button--orange" type="submit">S'abonner</button>
        {% if form.posted_successfully? %}<p class="newsletter__ok">Merci, vous êtes inscrit.</p>{% endif %}
      {% endform %}
    </div>

    <div class="footer__cols">
      {% for i in (1..3) %}
        {%- assign menu_key = 'menu_' | append: i -%}
        {%- assign title_key = 'title_' | append: i -%}
        {%- assign menu = linklists[section.settings[menu_key]] -%}
        {% if menu.links.size > 0 %}
          <nav aria-label="{{ section.settings[title_key] }}">
            <h3>{{ section.settings[title_key] }}</h3>
            {% for link in menu.links %}<a href="{{ link.url }}">{{ link.title }}</a>{% endfor %}
          </nav>
        {% endif %}
      {% endfor %}
    </div>

    <div class="footer__legal">
      {% for policy in shop.policies %}<a href="{{ policy.url }}">{{ policy.title }}</a>{% endfor %}
      <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}</p>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Pied de page",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titre newsletter", "default": "Soyez les premiers" },
    { "type": "text", "id": "heading_accent", "label": "Fin du titre (en italique orange)", "default": "informés." },
    { "type": "textarea", "id": "text", "label": "Texte", "default": "Nouveautés en avant-première et conseils simples pour la peau mature. Désinscription à tout moment." },
    { "type": "text", "id": "title_1", "label": "Colonne 1 : titre", "default": "BOUTIQUE" },
    { "type": "link_list", "id": "menu_1", "label": "Colonne 1 : menu", "default": "main-menu" },
    { "type": "text", "id": "title_2", "label": "Colonne 2 : titre", "default": "AIDE" },
    { "type": "link_list", "id": "menu_2", "label": "Colonne 2 : menu", "default": "footer" },
    { "type": "text", "id": "title_3", "label": "Colonne 3 : titre", "default": "À PROPOS" },
    { "type": "link_list", "id": "menu_3", "label": "Colonne 3 : menu" }
  ]
}
{% endschema %}
