{%- if section.blocks.size > 0 -%}
<section class="section{% if section.settings.soft %} section--soft{% endif %}">
  <div class="container">
    {% if section.settings.eyebrow != blank %}<p class="section__eyebrow">{% render 'stars', count: 5 %} {{ section.settings.eyebrow }}</p>{% endif %}
    <h2 class="section__title">{{ section.settings.heading }} {% if section.settings.heading_accent != blank %}<em>{{ section.settings.heading_accent }}</em>{% endif %}</h2>
    {% if section.settings.subheading != blank %}<p class="section__sub">{{ section.settings.subheading }}</p>{% endif %}

    <div class="carousel" data-carousel>
      <div class="carousel__track" data-carousel-track>
        {% for block in section.blocks %}
          <figure class="review{% if block.settings.image != blank %} review--photo{% endif %}" {{ block.shopify_attributes }}>
            {% if block.settings.image != blank %}
              <div class="review__media">
                {{ block.settings.image | image_url: width: 700 | image_tag: loading: 'lazy', alt: block.settings.name, class: 'review__img' }}
                <div class="review__overlay">
                  {% render 'stars', count: block.settings.stars %}
                  {% if block.settings.title != blank %}<h3>« {{ block.settings.title }} »</h3>{% endif %}
                </div>
              </div>
            {% else %}
              {% render 'stars', count: block.settings.stars %}
              {% if block.settings.title != blank %}<h3>« {{ block.settings.title }} »</h3>{% endif %}
            {% endif %}
            <p>{{ block.settings.text }}</p>
            <figcaption><strong>{{ block.settings.name }}</strong><span>{% render 'icon', name: 'check' %} Acheteur vérifié</span></figcaption>
          </figure>
        {% endfor %}
      </div>
      {% if section.blocks.size > 3 %}
        <div class="carousel__nav">
          <button type="button" data-carousel-step="-1" aria-label="Précédent">‹</button>
          <button type="button" data-carousel-step="1" aria-label="Suivant">›</button>
        </div>
      {% endif %}
    </div>

    {% if section.settings.button_label != blank %}
      <p class="center"><a class="button button--big" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label }}</a></p>
      {% if section.settings.note != blank %}<p class="center small">{{ section.settings.note }}</p>{% endif %}
    {% endif %}
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Témoignages",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Petite ligne sous les étoiles (chiffres réels uniquement)" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Ils ont fait le changement" },
    { "type": "text", "id": "heading_accent", "label": "Fin du titre (italique vert)" },
    { "type": "textarea", "id": "subheading", "label": "Texte sous le titre" },
    { "type": "checkbox", "id": "soft", "label": "Fond crème", "default": true },
    { "type": "text", "id": "button_label", "label": "Texte du bouton" },
    { "type": "url", "id": "button_link", "label": "Lien du bouton" },
    { "type": "text", "id": "note", "label": "Note sous le bouton" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Avis",
      "settings": [
        { "type": "range", "id": "stars", "label": "Étoiles", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "text", "id": "title", "label": "Titre" },
        { "type": "textarea", "id": "text", "label": "Avis (uniquement de vrais clients, avec leur accord)" },
        { "type": "image_picker", "id": "image", "label": "Photo (facultative, avec l'accord du client)" },
        { "type": "text", "id": "name", "label": "Prénom et initiale", "default": "Prénom N." }
      ]
    }
  ],
  "presets": [{ "name": "Témoignages" }]
}
{% endschema %}
