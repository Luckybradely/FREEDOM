{%- assign total = section.settings.n5 | plus: 0 | plus: section.settings.n4 | plus: section.settings.n3 | plus: section.settings.n2 | plus: section.settings.n1 -%}
{%- if total > 0 -%}
<section class="section">
  <div class="container">
    <h2 class="section__title">{{ section.settings.heading }}</h2>
    <div class="summary">
      <div class="summary__score">
        <strong>{{ section.settings.average }}</strong>
        {% render 'stars', count: 5 %}
        <span>{{ total }} avis</span>
      </div>
      <div class="summary__bars">
        {% for i in (1..5) reversed %}
          {%- assign key = 'n' | append: i -%}
          {%- assign count = section.settings[key] | plus: 0 -%}
          <div class="summary__bar">
            <span>{{ i }} étoile{% if i > 1 %}s{% endif %}</span>
            <div class="bar"><div style="width: {{ count | times: 100.0 | divided_by: total }}%"></div></div>
            <span>{{ count }}</span>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Résumé des avis",
  "settings": [
    { "type": "paragraph", "content": "Saisissez vos vrais chiffres (depuis votre application d'avis). La section reste masquée tant que tout est à 0." },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Avis clients vérifiés" },
    { "type": "text", "id": "average", "label": "Note moyenne (ex : 4,5)", "default": "0" },
    { "type": "text", "id": "n5", "label": "Nombre d'avis 5 étoiles", "default": "0" },
    { "type": "text", "id": "n4", "label": "Nombre d'avis 4 étoiles", "default": "0" },
    { "type": "text", "id": "n3", "label": "Nombre d'avis 3 étoiles", "default": "0" },
    { "type": "text", "id": "n2", "label": "Nombre d'avis 2 étoiles", "default": "0" },
    { "type": "text", "id": "n1", "label": "Nombre d'avis 1 étoile", "default": "0" }
  ],
  "presets": [{ "name": "Résumé des avis" }]
}
{% endschema %}
