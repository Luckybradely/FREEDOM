<section class="section section--soft">
  <div class="container container--narrow">
    <h2 class="section__title">{{ section.settings.heading }}</h2>
    {% for block in section.blocks %}
      <details class="faq" {{ block.shopify_attributes }}>
        <summary>{{ block.settings.question }}</summary>
        <p>{{ block.settings.answer }}</p>
      </details>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Questions fréquentes",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titre", "default": "Vos questions" }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "Question" },
        { "type": "textarea", "id": "answer", "label": "Réponse" }
      ]
    }
  ],
  "presets": [{ "name": "Questions fréquentes" }]
}
{% endschema %}
