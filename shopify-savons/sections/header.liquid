<header class="header">
  <div class="container header__inner">
    <details class="menu">
      <summary aria-label="Menu">{% render 'icon', name: 'menu' %}</summary>
      <nav class="menu__panel" aria-label="Navigation principale">
        {% for link in linklists[section.settings.menu].links %}
          <a href="{{ link.url }}"{% if link.active %} aria-current="page"{% endif %}>{{ link.title }}</a>
        {% endfor %}
      </nav>
    </details>

    <a class="header__logo" href="{{ routes.root_url }}">
      {%- if section.settings.logo != blank -%}
        {{ section.settings.logo | image_url: width: 400 | image_tag: alt: shop.name, class: 'header__logo-img' }}
      {%- else -%}
        {{ shop.name }}
      {%- endif -%}
    </a>

    <div class="header__icons">
      <a href="{{ routes.search_url }}" aria-label="Rechercher">{% render 'icon', name: 'search' %}</a>
      {% if shop.customer_accounts_enabled %}<a href="{{ routes.account_url }}" aria-label="Mon compte">{% render 'icon', name: 'account' %}</a>{% endif %}
      <a class="header__cart" href="{{ routes.cart_url }}" aria-label="Panier ({{ cart.item_count }})">
        {% render 'icon', name: 'cart' %}
        {% if cart.item_count > 0 %}<span class="header__badge">{{ cart.item_count }}</span>{% endif %}
      </a>
    </div>
  </div>
</header>

{% schema %}
{
  "name": "En-tête",
  "settings": [
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu" },
    { "type": "image_picker", "id": "logo", "label": "Logo (sinon le nom de la boutique)" }
  ]
}
{% endschema %}
