<section class="section">
  <div class="container container--narrow">
    <h1>Votre panier</h1>

    {% if cart.item_count > 0 %}
      <form action="{{ routes.cart_url }}" method="post">
        <ul class="cart">
          {% for item in cart.items %}
            <li class="cart__item">
              <div class="cart__thumb">
                {% if item.image %}{{ item.image | image_url: width: 160 | image_tag: loading: 'lazy', alt: item.product.title }}{% endif %}
              </div>
              <div class="cart__details">
                <a href="{{ item.url }}">{{ item.product.title }}</a>
                {% unless item.product.has_only_default_variant %}<p>{{ item.variant.title }}</p>{% endunless %}
                <p>{{ item.final_price | money }}</p>
              </div>
              <div class="cart__qty">
                <label for="qty-{{ item.index }}">Quantité</label>
                <input id="qty-{{ item.index }}" type="number" name="updates[]" value="{{ item.quantity }}" min="0">
              </div>
              <p class="cart__line">{{ item.final_line_price | money }}</p>
            </li>
          {% endfor %}
        </ul>

        <p class="cart__total">Total : <strong>{{ cart.total_price | money }}</strong></p>
        <div class="cart__actions">
          <button class="button button--secondary" type="submit" name="update">Mettre à jour</button>
          <button class="button" type="submit" name="checkout">Payer</button>
        </div>
      </form>
    {% else %}
      <p>Votre panier est vide.</p>
      <a class="button" href="{{ routes.all_products_collection_url }}">Voir nos savons</a>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Panier",
  "settings": []
}
{% endschema %}
