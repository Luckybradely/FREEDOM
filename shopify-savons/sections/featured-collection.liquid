<section class="section">
  <div class="container">
    <h2 class="section__title">{{ section.settings.heading }}</h2>
    {%- assign col = section.settings.collection | default: collections['all'] -%}
    <div class="grid grid--4">
      {% for product in col.products limit: section.settings.products_count %}
        {% render 'product-card', product: product %}
      {% else %}
        <p>Ajoutez des produits dans votre boutique pour les voir ici.</p>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Collection mise en avant",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titre", "default": "Nos savons" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "products_count", "label": "Nombre de produits", "min": 2, "max": 12, "step": 1, "default": 4 }
  ],
  "presets": [{ "name": "Collection mise en avant" }]
}
{% endschema %}
