<section class="section{% if section.settings.soft %} section--soft{% endif %}">
  <div class="container feature{% if section.settings.image_left %} feature--reverse{% endif %}">
    <div class="feature__text">
      <h2>{{ section.settings.heading }} {% if section.settings.heading_accent != blank %}<em>{{ section.settings.heading_accent }}</em>{% endif %}</h2>
      <div class="rte">{{ section.settings.text }}</div>
    </div>

    <div class="feature__side">
      {% if section.blocks.size > 0 %}
        <ul class="ingredients">
          {% for block in section.blocks %}
            <li {{ block.shopify_attributes }}>
              <span class="trust__icon">{% render 'icon', name: block.settings.icon %}</span>
              <div>
                <strong>{{ block.settings.title }}</strong>
                <span>{{ block.settings.text }}</span>
              </div>
            </li>
          {% endfor %}
        </ul>
      {% elsif section.settings.image != blank %}
        {{ section.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy', alt: section.settings.heading, class: 'feature__img' }}
      {% else %}
        <div class="card__placeholder feature__img" aria-hidden="true"></div>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Texte + image / ingrédients",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titre", "default": "Votre titre" },
    { "type": "text", "id": "heading_accent", "label": "Mot en italique vert", "default": "ici" },
    { "type": "richtext", "id": "text", "label": "Texte", "default": "<p>Votre texte.</p>" },
    { "type": "image_picker", "id": "image", "label": "Image (utilisée s'il n'y a pas d'ingrédients)" },
    { "type": "checkbox", "id": "image_left", "label": "Image / liste à gauche", "default": false },
    { "type": "checkbox", "id": "soft", "label": "Fond crème", "default": false }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Ingrédient",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icône", "default": "leaf", "options": [{ "value": "leaf", "label": "Feuille" }, { "value": "drop", "label": "Goutte" }, { "value": "heart", "label": "Cœur" }, { "value": "shield", "label": "Bouclier" }, { "value": "clock", "label": "Horloge" }] },
        { "type": "text", "id": "title", "label": "Nom", "default": "Ingrédient" },
        { "type": "text", "id": "text", "label": "Rôle" }
      ]
    }
  ],
  "presets": [{ "name": "Texte + image / ingrédients" }]
}
{% endschema %}
